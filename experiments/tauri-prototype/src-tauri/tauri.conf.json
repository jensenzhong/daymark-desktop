{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daymark Prototype",
  "version": "0.1.0",
  "identifier": "com.daymark.prototype",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Daymark Prototype",
      "width": 360,
      "height": 440,
      "minWidth": 240,
      "minHeight": 200,
      "decorations": true,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'" }
  },
  "bundle": { "active": false, "icon": ["../../../build/icon.png"] }
}
